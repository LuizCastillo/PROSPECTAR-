# ---- Servidor ----
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# ---- Supabase ----
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- OpenStreetMap (busca de empresas — sem custo, sem API key) ----
# kumi.systems em vez de overpass-api.de: a instância "oficial" costuma
# bloquear tráfego de provedores de nuvem (Render, AWS, etc.).
OVERPASS_API_URL=https://overpass.kumi.systems/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Nominatim exige um identificador de app no User-Agent (política de uso).
OSM_USER_AGENT=LeadForge/1.0 (contato: seu-email@dominio.com)

# ---- LLM ----
LLM_PROVIDER=mock
LLM_API_KEY=

# ---- Resend (não implementado ainda) ----
RESEND_API_KEY=
